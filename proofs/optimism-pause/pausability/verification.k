requires "edsl.md"
requires "lemmas/lemmas.k"

module VERIFICATION-SUMMARIES
  imports EDSL
  imports LEMMAS

  // Exact supplied runtime bytecode constants. These are definitional names only;
  // all program behavior is executed by the pinned EVM semantics.
  syntax Bytes ::= "#optimismPortal2Program" [function, total]
  rule #optimismPortal2Program => #parseByteStack("")

  syntax Bytes ::= "#l1StandardBridgeProgram" [function, total]
  rule #l1StandardBridgeProgram => #parseByteStack("")

  syntax Bytes ::= "#l1ERC721BridgeProgram" [function, total]
  rule #l1ERC721BridgeProgram => #parseByteStack("")

  syntax Bytes ::= "#l1CrossDomainMessengerProgram" [function, total]
  rule #l1CrossDomainMessengerProgram => #parseByteStack("")

  // Executed environmental contracts:
  //   trueResponder: return abi.encode(true) for paused().
  //   otherBridgeResponder: return address(0x3000) for xDomainMessageSender().
  syntax Bytes ::= "#trueResponderProgram" [function, total]
  rule #trueResponderProgram => #parseByteStack("0x600160005260206000f3")

  syntax Bytes ::= "#otherBridgeResponderProgram" [function, total]
  rule #otherBridgeResponderProgram => #parseByteStack("0x61300060005260206000f3")
endmodule

module VERIFICATION
  imports VERIFICATION-SUMMARIES
endmodule

